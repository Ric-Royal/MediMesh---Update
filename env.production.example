# Production deployments must inject secrets through *_FILE paths or a managed
# secret store. Never place credential values in this file.
NODE_ENV=production
PUBLIC_BASE_URL=https://health.example.ke
ALLOWED_ORIGINS=https://health.example.ke
REQUIRE_MFA=true
SESSION_TTL_SECONDS=900
AUDIT_FAIL_CLOSED=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_FILE=/run/secrets/database_ca
REDIS_URL=rediss://redis.example.internal:6379
MINIO_ENDPOINT=https://objects.example.internal
MPESA_ENVIRONMENT=production
MPESA_CALLBACK_URL=https://health.example.ke/api/payments/mpesa/callback

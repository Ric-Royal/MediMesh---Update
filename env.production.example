# Compatibility pointer: production configuration is maintained in
# deployment/.env.example and deployment/compose.prod.yml.
#
# Do not run the root development docker-compose.yml in production.
# Follow docs/PRODUCTION-OPERATIONS.md.

NODE_ENV=production
PUBLIC_BASE_URL=https://clinic.example.org
ALLOWED_ORIGINS=https://clinic.example.org
REQUIRE_MFA=true
ALLOW_DEMO_AUTH=false
ALLOW_INSECURE_DEV_TOKENS=false
REACT_APP_IDENTITY_MODE=local
REACT_APP_SHOW_DEMO_LOGIN=false

# All credentials must be mounted from deployment/secrets using NAME_FILE.
# See deployment/.env.example for versioned image/domain configuration.

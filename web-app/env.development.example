# MediMesh Frontend Environment Configuration
# Copy this file to .env for local development
# DO NOT commit .env files to version control

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================

# Use the built-in account system unless an external identity provider is
# explicitly configured and approved for the deployment.
VITE_IDENTITY_MODE=local

# API Backend URL
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# ===========================================
# KEYCLOAK CONFIGURATION (Production Mode)
# ===========================================

# Keycloak Server URL
VITE_KEYCLOAK_URL=http://localhost:8080

# Keycloak Realm Name
VITE_KEYCLOAK_REALM=medimesh

# Keycloak Client ID
VITE_KEYCLOAK_CLIENT_ID=medimesh-client

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

VITE_SHOW_DEMO_LOGIN=true

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================

# For production deployment, set:
# VITE_IDENTITY_MODE=local
# VITE_API_URL=https://api.yourdomain.com
# VITE_KEYCLOAK_URL=https://auth.yourdomain.com

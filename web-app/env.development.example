# MediMesh Frontend Environment Configuration
# Copy this file to .env for local development
# DO NOT commit .env files to version control

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================

# Development Mode (uses simple JWT auth with any username/password)
# Set to 'true' for development, 'false' for production Keycloak
REACT_APP_DEV_MODE=true

# API Backend URL
REACT_APP_API_URL=http://localhost:3001

# ===========================================
# KEYCLOAK CONFIGURATION (Production Mode)
# ===========================================

# Keycloak Server URL
REACT_APP_KEYCLOAK_URL=http://localhost:8080

# Keycloak Realm Name
REACT_APP_KEYCLOAK_REALM=medimesh

# Keycloak Client ID
REACT_APP_KEYCLOAK_CLIENT_ID=medimesh-client

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

# React Development Server Port
PORT=3000

# Browser Auto-Open
BROWSER=true

# Fast Refresh
FAST_REFRESH=true

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================

# For production deployment, set:
# REACT_APP_DEV_MODE=false
# REACT_APP_API_URL=https://api.yourdomain.com
# REACT_APP_KEYCLOAK_URL=https://auth.yourdomain.com 
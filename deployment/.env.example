COMPOSE_PROJECT_NAME=medimesh-clinic
DOMAIN=clinic.example.org
TLS_EMAIL=it@example.org

# Pin every production image to a tested immutable version or digest.
MEDIMESH_API_IMAGE=ghcr.io/ric-royal/medimesh---update-api:1.0.0-rc.1
MEDIMESH_WEB_IMAGE=ghcr.io/ric-royal/medimesh---update-web:1.0.0-rc.1
TRAEFIK_IMAGE=traefik:v3.3.6
POSTGRES_IMAGE=postgres:16.8-alpine
REDIS_IMAGE=redis:7.4.2-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
BACKUP_HELPER_IMAGE=alpine:3.21.3

BOOTSTRAP_ADMIN_USERNAME=admin
SESSION_TTL_SECONDS=28800
LOG_LEVEL=info

# Change to production only after the Daraja production values are stored in
# deployment/secrets and the public callback has been verified over HTTPS.
MPESA_ENVIRONMENT=sandbox

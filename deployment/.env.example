COMPOSE_PROJECT_NAME=medimesh-clinic
DOMAIN=clinic.example.org
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Use release images pinned by digest.
MEDIMESH_API_IMAGE=ghcr.io/example/medimesh-api@sha256:replace_with_64_hex_digest
MEDIMESH_WEB_IMAGE=ghcr.io/example/medimesh-web@sha256:replace_with_64_hex_digest
CLAMAV_IMAGE=clamav/clamav:1.4@sha256:e7ead98e7e07231b151bce988e0cfb0a3b46e6e7046d9dd44fd838c0df724a03

# Approved externally managed, TLS-enabled services.
REDIS_URL=rediss://redis.example.org:6380
MINIO_ENDPOINT=https://objects.example.org

BOOTSTRAP_ADMIN_USERNAME=admin
SESSION_TTL_SECONDS=900
LOG_LEVEL=info

MPESA_ENVIRONMENT=sandbox

# Backup sealing. Keep the age identity and minisign secret key offline or in
# the approved backup-admin vault; only public values belong here.
BACKUP_AGE_RECIPIENT=age1replace_with_approved_recipient
BACKUP_AGE_IDENTITY_FILE=/mnt/backup-keys/age-identity.txt
BACKUP_KEY_VERSION=2026-01
BACKUP_MINISIGN_PUBLIC_KEY=replace_with_approved_public_key
BACKUP_MINISIGN_SECRET_KEY_FILE=/mnt/backup-keys/minisign-secret.key
BACKUP_WORK_ROOT=/mnt/encrypted-backup-work
